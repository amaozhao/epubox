# Application settings
DEBUG=False

# Translatable body tokens only; MAX is the split target (up to +1000 for a short tail).
EPUB_CHUNK_MAX_TOKENS=2000
# Minimum after splitting; a complete shorter HTML body may still use one request.
EPUB_CHUNK_MIN_TOKENS=500

# Logging settings
LOG_LEVEL=WARNING
LOG_FILE=logs/epubox.log

AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1
AGNES_MODEL=agnes-2.0-flash
AGNES_TEXT_RPM=10
DEEPSEEK_API_KEY=
STEPFUN_API_KEY=

CR_PROXY_API_KEY=
CR_PROXY_BASE_URL=
CR_PROXY_MODEL=gpt-5.4
